{
  "name": "fugue",
  "version": "1.0.0-beta.1",
  "type": "module",
  "description": "Fugue: Nuxt layers and a content-site template, published as @altafusion/* packages",
  "scripts": {
    "clean:nuxt": "pnpm -r --if-present run clean",
    "reset": "bash scripts/reset.sh",
    "reset:fugue-content-site": "pnpm --filter @altafusion/fugue-content-site-template reset",
    "typecheck": "pnpm -r --if-present run typecheck",
    "lint": "pnpm -r --if-present run lint",
    "lint:fix": "pnpm -r --if-present run lint:fix",
    "lint:fugue-content-site": "pnpm --filter @altafusion/fugue-content-site-template lint",
    "lint:fix:fugue-content-site": "pnpm --filter @altafusion/fugue-content-site-template lint:fix",
    "typecheck:fugue-content-site": "pnpm --filter @altafusion/fugue-content-site-template typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:chromium": "playwright test --project chromium",
    "test:e2e:webkit": "playwright test --project webkit",
    "test:e2e:headed": "playwright test --headed --project chromium",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug --project chromium",
    "test:e2e:report": "playwright show-report",
    "test:e2e:fugue-content-site": "PLAYWRIGHT_BASE_URL=http://localhost:8001/ playwright test e2e/fugue-content-site --project chromium",
    "dev:fugue-content-site": "pnpm --filter @altafusion/fugue-content-site-template dev",
    "link:nuxt-studio": "bash scripts/dev/link-local-nuxt-studio.sh",
    "unlink:nuxt-studio": "bash scripts/dev/unlink-local-nuxt-studio.sh",
    "studio-token": "bash scripts/dev/studio-token.sh",
    "build:fugue-content-site": "pnpm --filter @altafusion/fugue-content-site-template build",
    "prepare": "husky",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "changeset publish"
  },
  "keywords": [],
  "author": "Altafusion",
  "license": "MIT",
  "engines": {
    "node": ">=24.15.0"
  },
  "packageManager": "pnpm@12.21.0",
  "devDependencies": {
    "@altafusion/test-kit": "workspace:*",
    "@changesets/cli": "catalog:dev",
    "@commitlint/cli": "catalog:dev",
    "@commitlint/config-conventional": "catalog:dev",
    "@playwright/test": "catalog:testing",
    "@vitejs/plugin-vue": "catalog:testing",
    "@vue/test-utils": "^2.6.0",
    "concurrently": "catalog:dev",
    "happy-dom": "catalog:testing",
    "husky": "^9.1.7",
    "tailwindcss": "^4.3.5",
    "vitest": "catalog:testing",
    "vue": "catalog:apps"
  },
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/altafusion/fugue.git"
  }
}
