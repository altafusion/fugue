engine-strict=true
node-linker=hoisted
# pnpm lockfiles store git@github.com URLs; rewrite to HTTPS for CI (Netlify has no SSH).
git-host=github.com:git:https://github.com/
# Netlify Builds: GITHUB_TOKEN (PAT, Contents:read on altafusion-monorepo) — not STUDIO_GITHUB_TOKEN (Functions only).
//github.com/:_authToken=${GITHUB_TOKEN}
