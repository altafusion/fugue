# =============================================================================
# Copy to .env (gitignored). Restart after edits: pnpm dev
# Production Netlify + GitHub + Google: developer-docs
#   → /docus/docus-setup/standalone-settings
# =============================================================================

# -----------------------------------------------------------------------------
# Local dev — HTTP port
# -----------------------------------------------------------------------------
MY_DOCS_DEV_PORT=8002
PORT=8002

# -----------------------------------------------------------------------------
# Read gate — optional; add @altafusion/fugue-simple-auth on the app (see the fugue-simple-auth README)
# -----------------------------------------------------------------------------
# MY_DOCS_ACCESS_KEY=

# -----------------------------------------------------------------------------
# Studio — Google OAuth (local + production redirect URIs in standalone-settings)
# -----------------------------------------------------------------------------
# STUDIO_GOOGLE_CLIENT_ID=
# STUDIO_GOOGLE_CLIENT_SECRET=
# STUDIO_GOOGLE_MODERATORS=editor@gmail.com

# -----------------------------------------------------------------------------
# Studio — Publish PAT (Netlify Functions; optional locally)
# Fine-grained → THIS docs repo (e.g. my-site-docs) → Contents: Read and write
# NOT altafusion-monorepo — see standalone-settings §3b
# -----------------------------------------------------------------------------
# STUDIO_GITHUB_TOKEN=github_pat_...

# -----------------------------------------------------------------------------
# Netlify Builds only — NOT the same as STUDIO_GITHUB_TOKEN
# Only if you install private git deps from altafusion-monorepo — see standalone-settings
# -----------------------------------------------------------------------------
# GITHUB_TOKEN=github_pat_...

# Optional — Studio AI features only
# AI_GATEWAY_API_KEY=
