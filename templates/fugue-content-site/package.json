{
  "name": "@altafusion/fugue-content-site-template",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "postinstall": "node ../../packages-platform/nuxt-base/dev/nuxt-cli.mjs prepare",
    "clean": "rm -rf .output .nuxt node_modules/.cache node_modules/.vite dist .data",
    "reset": "node ../../packages-platform/nuxt-base/dev/reset-fugue-content-site.mjs fugueContentSite",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prebuild": "pnpm --filter @altafusion/fugue-content run prepare:types",
    "build": "node ../../packages-platform/nuxt-base/dev/nuxt-cli.mjs build",
    "generate": "node ../../packages-platform/nuxt-base/dev/nuxt-cli.mjs generate",
    "preview": "node ../../packages-platform/nuxt-base/dev/nuxt-cli.mjs preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "node ../../packages-platform/nuxt-base/dev/nuxt-cli.mjs typecheck"
  },
  "dependencies": {
    "@altafusion/fugue-content": "workspace:*",
    "@altafusion/fugue-theme": "workspace:*",
    "@altafusion/shell": "workspace:*",
    "@iconify-json/lucide": "catalog:ui",
    "@vue/server-renderer": "catalog:apps",
    "better-sqlite3": "catalog:content",
    "nuxt": "catalog:apps",
    "vue": "catalog:apps"
  },
  "devDependencies": {
    "@altafusion/eslint-config": "workspace:*",
    "@altafusion/nuxt-base": "workspace:*",
    "@altafusion/test-kit": "workspace:*",
    "debug": "catalog:utils",
    "eslint": "catalog:dev",
    "extend": "catalog:utils",
    "slugify": "catalog:utils",
    "typescript": "catalog:dev",
    "vue-router": "catalog:apps"
  }
}
