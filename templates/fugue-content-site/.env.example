# =============================================================================
# templates/fugue-content-site/.env — copy to .env (gitignored)
# Restart after edits: pnpm dev:fugue-content-site
# Deploy: developer-docs /fugue-content/starter-template/pilot-deploy-checklist
# Studio OAuth: /fugue-content/starter-template/studio-access-setup#configure-google-oauth
# =============================================================================

# -----------------------------------------------------------------------------
# Local dev — HTTP port (canonical fallback: templateDevPorts.cmsSite in @altafusion/nuxt-base)
# Generic names — same keys in every Fugue Content app; values differ per app.
# -----------------------------------------------------------------------------
SITE_DEV_PORT=8001
PORT=8001

# -----------------------------------------------------------------------------
# Peek gate — set locally; mirror on Netlify Functions for production
# Log in at /login before header Edit appears
# -----------------------------------------------------------------------------
SITE_ACCESS_KEY=

# Builds scope: SITE_AUTH_ENABLED=true (see netlify.toml) — required for Studio SSR

# -----------------------------------------------------------------------------
# Google OAuth — operator guide (redirect URIs + Netlify Functions):
#   developer-docs /fugue-content/starter-template/studio-access-setup#configure-google-oauth
# Console: https://console.cloud.google.com/apis/credentials → Web application
# Local redirect URI (exact):
#   http://localhost:8001/__nuxt_studio/auth/google
# Production:
#   https://<your-netlify-host>/__nuxt_studio/auth/google
# -----------------------------------------------------------------------------
# STUDIO_GOOGLE_CLIENT_ID=
# STUDIO_GOOGLE_CLIENT_SECRET=
# STUDIO_GOOGLE_MODERATORS=editor@gmail.com

# -----------------------------------------------------------------------------
# Step 2 — Netlify (dashboard — not this file)
# Base dir empty · config templates/fugue-content-site/netlify.toml · publish templates/fugue-content-site/dist
# Builds:  SITE_AUTH_ENABLED=true
# Functions: STUDIO_GOOGLE_*, STUDIO_GITHUB_TOKEN (omit SITE_ACCESS_KEY — authMode: studio)
# Prod Google redirect: https://<your-netlify-host>/__nuxt_studio/auth/google
# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
# Step 3 — STUDIO_GITHUB_TOKEN (Publish to Git on Netlify Functions)
# Fine-grained PAT → altafusion-monorepo → Contents: Read and write
# Commits land under templates/fugue-content-site/content/ (studio.repository.rootDir)
# Guide: /docus/docus-setup/studio-google#create-the-github-pat
# -----------------------------------------------------------------------------
# STUDIO_GITHUB_TOKEN=github_pat_...

# Optional — Studio AI features only
# AI_GATEWAY_API_KEY=
