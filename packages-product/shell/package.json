{
  "name": "@altafusion/shell",
  "type": "module",
  "version": "0.3.4",
  "description": "Shared site layout shells and Altafusion brand theme for consumer apps",
  "license": "MIT",
  "homepage": "https://github.com/altafusion/fugue/tree/main/packages-product/shell#readme",
  "bugs": {
    "url": "https://github.com/altafusion/fugue/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/altafusion/fugue.git",
    "directory": "packages-product/shell"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": "./nuxt.config.ts",
    "./app/composables/useBrandTheme": "./app/composables/useBrandTheme.ts",
    "./utils/altafusionBrandTheme": "./utils/altafusionBrandTheme.ts",
    "./lib/fugue-content-public-config": "./lib/fugue-content-public-config.ts",
    "./lib/injection-keys": "./lib/injection-keys.ts",
    "./themes/tailwind-shell.css": "./themes/tailwind-shell.css"
  },
  "main": "./nuxt.config.ts",
  "scripts": {
    "clean": "rm -rf .output .nuxt node_modules/.cache dist",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "peerDependencies": {
    "nuxt": ">=4.0.0",
    "vue": "^3.5.0",
    "vue-router": "^5.0.0"
  },
  "dependencies": {
    "@altafusion/fugue-ui": "workspace:*"
  },
  "devDependencies": {
    "@altafusion/eslint-config": "workspace:*",
    "@altafusion/nuxt-base": "workspace:*",
    "@iconify-json/lucide": "catalog:ui",
    "@types/node": "catalog:dev",
    "eslint": "catalog:dev",
    "nuxt": "catalog:apps",
    "typescript": "catalog:dev",
    "vue": "catalog:apps",
    "vue-router": "catalog:apps"
  },
  "files": [
    "**",
    "!**/*.test.ts",
    "!**/.nuxt",
    "!**/.output",
    "!**/.data",
    "!**/coverage",
    "!**/node_modules"
  ]
}
