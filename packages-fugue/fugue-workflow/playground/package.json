{
  "name": "@altafusion/fugue-workflow-playground",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "Standalone Nuxt app that consumes @altafusion/fugue-workflow to prove the orchestrator layer boots without product shell packages",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "postinstall": "nuxt prepare",
    "test:e2e": "playwright test --config playwright.config.ts",
    "test:e2e:chromium": "playwright test --config playwright.config.ts --project chromium",
    "test:e2e:headed": "playwright test --config playwright.config.ts --headed --project chromium",
    "test:e2e:ui": "playwright test --config playwright.config.ts --ui --project chromium",
    "test:e2e:debug": "playwright test --config playwright.config.ts --debug --project chromium"
  },
  "dependencies": {
    "@altafusion/fugue-workflow": "workspace:*",
    "nuxt": "catalog:apps",
    "pinia": "catalog:ui",
    "vue": "catalog:apps"
  },
  "devDependencies": {
    "@altafusion/eslint-config": "workspace:*",
    "@playwright/test": "catalog:testing",
    "@types/node": "catalog:dev",
    "eslint": "catalog:dev",
    "typescript": "catalog:dev"
  }
}
