{
  "name": "@altafusion/fugue-nuxt-ui",
  "type": "module",
  "version": "0.3.2",
  "description": "Unbranded Nuxt UI + Tailwind base layer for the Fugue family (no product brand tokens or fonts)",
  "license": "MIT",
  "homepage": "https://github.com/altafusion/fugue/tree/main/packages-fugue/fugue-nuxt-ui#readme",
  "bugs": {
    "url": "https://github.com/altafusion/fugue/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/altafusion/fugue.git",
    "directory": "packages-fugue/fugue-nuxt-ui"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": "./nuxt.config.ts",
    "./assets/css/nuxt-ui.css": "./assets/css/nuxt-ui.css"
  },
  "main": "./nuxt.config.ts",
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "peerDependencies": {
    "nuxt": ">=4.0.0"
  },
  "dependencies": {
    "@altafusion/eslint-config": "workspace:*",
    "@altafusion/nuxt-base": "workspace:*",
    "@nuxt/eslint": "catalog:dev",
    "@nuxt/icon": "catalog:ui",
    "@nuxt/ui": "catalog:ui",
    "tailwindcss": "catalog:ui"
  },
  "devDependencies": {
    "@types/node": "catalog:dev",
    "eslint": "catalog:dev",
    "nuxt": "catalog:apps",
    "typescript": "catalog:dev",
    "vue": "catalog:apps"
  },
  "files": [
    "**",
    "!**/*.test.ts",
    "!**/.nuxt",
    "!**/.output",
    "!**/.data",
    "!**/coverage",
    "!**/node_modules"
  ]
}
