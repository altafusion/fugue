{
  "name": "@altafusion/fugue-devtools-playground",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "Standalone Nuxt app that extends only @altafusion/fugue-devtools so the drawer can be tried in a browser",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "postinstall": "nuxt prepare"
  },
  "dependencies": {
    "@altafusion/fugue-devtools": "workspace:*",
    "@altafusion/nuxt-base": "workspace:*",
    "nuxt": "catalog:apps",
    "vue": "catalog:apps"
  },
  "devDependencies": {
    "@altafusion/eslint-config": "workspace:*",
    "@types/node": "catalog:dev",
    "eslint": "catalog:dev",
    "typescript": "catalog:dev"
  }
}
