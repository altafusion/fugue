{
  "name": "@altafusion/eslint-config",
  "type": "module",
  "version": "0.2.0",
  "description": "Shared ESLint factories and stylistic defaults for Altafusion platform and product packages",
  "license": "MIT",
  "homepage": "https://github.com/altafusion/fugue/tree/main/packages-platform/eslint-config#readme",
  "bugs": {
    "url": "https://github.com/altafusion/fugue/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/altafusion/fugue.git",
    "directory": "packages-platform/eslint-config"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": "./eslint.ts",
    "./stylistic": "./stylistic.ts"
  },
  "main": "./eslint.ts",
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "devDependencies": {
    "@antfu/eslint-config": "catalog:dev",
    "@types/node": "catalog:dev",
    "eslint": "catalog:dev",
    "typescript": "catalog:dev"
  },
  "files": [
    "**",
    "!**/*.test.ts",
    "!**/.nuxt",
    "!**/.output",
    "!**/.data",
    "!**/coverage",
    "!**/node_modules"
  ],
  "peerDependencies": {
    "@antfu/eslint-config": "catalog:dev",
    "eslint": "catalog:dev"
  },
  "peerDependenciesMeta": {
    "@antfu/eslint-config": {
      "optional": true
    },
    "eslint": {
      "optional": true
    }
  }
}
