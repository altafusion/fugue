{
  "name": "@altafusion/eslint-config",
  "type": "module",
  "version": "0.3.3",
  "description": "Shared ESLint factories and stylistic defaults for Altafusion platform and product packages",
  "license": "MIT",
  "homepage": "https://github.com/altafusion/fugue/tree/main/packages-platform/eslint-config#readme",
  "bugs": {
    "url": "https://github.com/altafusion/fugue/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/altafusion/fugue.git",
    "directory": "packages-platform/eslint-config"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/eslint.js",
    "types": "./dist/eslint.d.ts",
    "exports": {
      ".": {
        "types": "./dist/eslint.d.ts",
        "default": "./dist/eslint.js"
      },
      "./stylistic": {
        "types": "./dist/stylistic.d.ts",
        "default": "./dist/stylistic.js"
      }
    }
  },
  "exports": {
    ".": "./eslint.ts",
    "./stylistic": "./stylistic.ts"
  },
  "main": "./eslint.ts",
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "build": "tsc -p tsconfig.build.json",
    "prepack": "pnpm run build",
    "postpack": "rm -rf dist"
  },
  "devDependencies": {
    "@antfu/eslint-config": "catalog:dev",
    "@types/node": "catalog:dev",
    "eslint": "catalog:dev",
    "typescript": "catalog:dev"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "peerDependencies": {
    "@antfu/eslint-config": "catalog:dev",
    "eslint": "catalog:dev"
  }
}
